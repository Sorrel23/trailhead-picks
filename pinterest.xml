---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <description>{{ site.description | xml_escape }}</description>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/pinterest.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- comment -%}
      Feed for Pinterest Auto-publish (Settings > Auto-publish). Pinterest makes one Pin per new item.
      A post is only listed once its pin image (assets/pins/<slug>.png, made by the GitHub Action)
      exists, so Pinterest never fetches a missing image. Posts dated before feed_start were already
      pinned by hand, so they're left out to avoid duplicate pins.
    {%- endcomment -%}
    {%- assign feed_start = 20261117 -%}
    {%- assign pin_paths = site.static_files | where_exp: "f", "f.path contains '/assets/pins/'" | map: "path" | join: "|" -%}
    {%- for post in site.posts limit: 25 -%}
      {%- assign img_path = "/assets/pins/" | append: post.slug | append: ".png" -%}
      {%- assign pdate = post.date | date: "%Y%m%d" | plus: 0 -%}
      {%- if pin_paths contains img_path and pdate >= feed_start -%}
      {%- assign img = site.url | append: site.baseurl | append: img_path %}
    <item>
      <title>{{ post.pin_title | default: post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.pin_text | default: post.description | xml_escape }}{% if post.pin_text and post.description %} | {{ post.description | xml_escape }}{% endif %}</description>
      <enclosure url="{{ img }}" type="image/png" length="0"/>
      <media:content url="{{ img }}" medium="image" type="image/png"/>
    </item>
      {%- endif -%}
    {%- endfor %}
  </channel>
</rss>
